// Cloudflare Workers con static assets: sirve dist/ tal cual, sin código de servidor.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Dominio propio (zona en esta misma cuenta de Cloudflare). Cloudflare crea el DNS y el certificado.
  "routes": [
    { "pattern": "rlopezbarbarin.dev", "custom_domain": true },
    { "pattern": "www.rlopezbarbarin.dev", "custom_domain": true }
  ],
  // Sin subdominio *.workers.dev: la web solo existe en el dominio propio (evita contenido duplicado)
  "workers_dev": false,
  "preview_urls": false
}
