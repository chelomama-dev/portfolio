---
// Brida naranja: la etiqueta que se deja puesta en lo que está activo.
interface Props { label: string; meta?: string; class?: string }
const { label, meta, class: cls } = Astro.props;
---
<div class:list={['ziptag', cls]}>
  <svg class="ziptag__strap" viewBox="0 0 60 90" width="60" height="90" aria-hidden="true">
    <path d="M8 4 C 2 34, 22 62, 40 80" fill="none" stroke="var(--safety)" stroke-width="5" stroke-linecap="round" />
    <path d="M8 4 C 2 34, 22 62, 40 80" fill="none" stroke="var(--ink)" stroke-width="1" stroke-opacity=".35" stroke-dasharray="1 4" />
  </svg>
  <div class="ziptag__body">
    <span class="ziptag__hole" aria-hidden="true"></span>
    <strong>{label}</strong>
    {meta && <span class="ziptag__meta">{meta}</span>}
  </div>
</div>

<style>
  .ziptag { position: relative; width: 178px; pointer-events: none; }
  .ziptag__strap { position: absolute; left: 0; top: 0; overflow: visible; }
  .ziptag__body {
    position: absolute; left: 24px; top: 70px; width: 150px;
    padding: 30px 16px 16px;
    background: var(--safety); color: var(--ink);
    border-radius: 6px 6px 3px 3px;
    box-shadow: 0 10px 18px -8px rgb(0 0 0 / .45), inset 0 0 0 1px rgb(0 0 0 / .12);
    transform-origin: 50% 14px;
    transform: rotate(-9deg);
    animation: swing 1.6s var(--ease-out) .35s both;
  }
  .ziptag__hole {
    position: absolute; left: 50%; top: 9px; width: 12px; height: 12px; margin-left: -6px;
    border-radius: 50%; background: var(--cotton); box-shadow: inset 0 0 0 2px rgb(0 0 0 / .25);
  }
  strong {
    display: block;
    font-stretch: 66%; font-weight: 850; font-size: 1rem; line-height: 1.04;
    text-transform: uppercase; letter-spacing: .01em;
  }
  .ziptag__meta {
    display: block; margin-top: 10px; padding-top: 8px; border-top: 1.5px solid rgb(0 0 0 / .55);
    font-family: var(--font-mono); font-size: .6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: .02em;
  }
  @keyframes swing {
    0% { transform: rotate(14deg); }
    35% { transform: rotate(-16deg); }
    60% { transform: rotate(-4deg); }
    80% { transform: rotate(-11deg); }
    100% { transform: rotate(-9deg); }
  }
</style>
