---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
import Icon from './Icon.astro';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
---
<a href={`/blog/${post.id}`} class="post">
  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
  <div>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
  </div>
  <Icon name="arrow" size={22} class="post__arrow" />
</a>

<style>
  .post {
    display: grid; grid-template-columns: 180px minmax(0, 1fr) 24px; gap: 8px 32px; align-items: start;
    padding: 24px 0; border-bottom: 2px solid var(--ink);
  }
  time { font-family: var(--font-mono); font-size: .8125rem; text-transform: uppercase; color: var(--ink-3); padding-top: 6px; }
  h3 { font-stretch: 75%; font-weight: 800; font-size: 1.625rem; line-height: 1.1; text-transform: uppercase; }
  p { color: var(--ink-2); margin-top: 8px; max-width: 68ch; }
  .post :global(.post__arrow) { margin-top: 4px; transition: transform .3s var(--ease-out); }
  .post:hover h3 { text-decoration: underline; text-decoration-color: var(--safety); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .post:hover :global(.post__arrow) { transform: translateX(4px); }
  @media (max-width: 640px) {
    .post { grid-template-columns: minmax(0, 1fr) 24px; }
    time { grid-column: 1 / -1; padding-top: 0; }
  }
</style>
