---
import { NAV, SITE } from '../config';
import { cvLinks } from '../lib/cv';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && path.startsWith(href);
---
<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name}, inicio`}>
      <span class="brand__mark">{SITE.initials}</span>
      <span class="brand__name">{SITE.shortName}</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}><span class="q">{item.label}</span></a>
          </li>
        ))}
      </ul>
    </nav>
    {cvLinks.length > 0 && (
      <div class="header__cv">
        {cvLinks.map((c) => (
          <a href={c.href} class="btn btn--sm" download title={c.title} hreflang={c.lang}>
            <Icon name="download" size={16} />{c.label}
          </a>
        ))}
      </div>
    )}
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: var(--cotton);
    border-bottom: 2px solid var(--ink);
  }
  .header__inner { display: flex; align-items: center; gap: 12px 28px; min-height: 68px; }
  .brand { display: flex; align-items: center; gap: 12px; margin-right: auto; }
  .brand__mark {
    display: grid; place-items: center; width: 40px; height: 40px;
    background: var(--ink); color: var(--cotton);
    font-stretch: 70%; font-weight: 850; font-size: 1.125rem; letter-spacing: .02em;
  }
  .brand__name { font-stretch: 75%; font-weight: 800; font-size: 1.25rem; text-transform: uppercase; letter-spacing: .01em; }
  nav ul { display: flex; gap: 4px 22px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a {
    display: block; padding: 8px 0;
    font-stretch: 78%; font-weight: 700; font-size: .9375rem; text-transform: uppercase; letter-spacing: .05em;
    border-bottom: 3px solid transparent;
    transition: border-color .2s;
  }
  nav a:hover { border-bottom-color: var(--ink); }
  nav a[aria-current='page'] { border-bottom-color: var(--ink); }
  .header__cv { display: flex; gap: 8px; }

  @media (max-width: 860px) {
    .header__inner { flex-wrap: wrap; padding-block: 12px 0; }
    .header__cv { order: 2; }
    nav { order: 3; width: 100%; overflow-x: auto; border-top: 1px solid var(--label-strong); }
    nav ul { flex-wrap: nowrap; gap: 20px; }
    nav a { padding: 10px 0; white-space: nowrap; }
  }
  @media (max-width: 480px) {
    nav ul { gap: 14px; justify-content: space-between; }
    nav a { font-size: .8125rem; font-stretch: 70%; letter-spacing: .03em; }
  }
  @media (max-width: 420px) {
    .brand__name { display: none; }
  }
</style>
